{
	"compilerOptions": {
		"strict": true,
		"module": "commonjs",
		"moduleResolution": "node",
		"target": "es2022",
		"lib": ["es2022"],
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"declaration": true,
		"sourceMap": true,
		"outDir": "dist"
	},
	"include": ["credentials/**/*.ts", "nodes/**/*.ts", "nodes/**/*.json"],
	"exclude": ["node_modules", "dist", "tests"]
}
